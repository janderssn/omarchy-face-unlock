#!/usr/bin/python3 -I
"""Presence daemon for omarchy-face-unlock.

Reads a HID human-presence sensor through the kernel's IIO buffer, filters
out its short dropouts, and publishes who is in front of the laptop, and whether the camera's privacy
switch is on, to /run/omarchy-face-unlock/presence.json for the shell plugin and the lock
screen's PAM gate.

The sensor only reports real values while its buffer is enabled, and enabling
it needs root; that is the only reason this runs as a system service. It
opens no sockets and reads nothing but the sensor and one camera control;
it never reads a picture. The one thing it writes to hardware is a known
sensor's own detection settings, when the sensor has lost them.
"""

import errno
import fcntl
import glob
import json
import os
import re
import select
import signal
import struct
import sys
import time

STATE_DIR = os.environ.get("PRESENCE_STATE_DIR", "/run/omarchy-face-unlock")
STATE_FILE = os.path.join(STATE_DIR, "presence.json")
IIO_ROOT = os.environ.get("PRESENCE_IIO_ROOT", "/sys/bus/iio/devices")

# Presence must hold this long before someone counts as arrived; the sensor
# occasionally reports a person for a moment when there is none.
ARRIVE_SECONDS = float(os.environ.get("PRESENCE_ARRIVE_SECONDS", "1.0"))
# Absence must hold this long before someone counts as gone. The sensor drops
# to "nobody" whenever the camera is opened: about three seconds for a face
# scan, up to seven when a video call starts. Anything shorter is noise.
LEAVE_SECONDS = float(os.environ.get("PRESENCE_LEAVE_SECONDS", "8.0"))
# Attention is held across the same dropouts.
ATTENTION_HOLD_SECONDS = float(os.environ.get("PRESENCE_ATTENTION_HOLD_SECONDS", "5.0"))

# How often the camera's privacy switch is read.
PRIVACY_POLL_SECONDS = 2.0
# VIDIOC_G_CTRL and V4L2_CID_PRIVACY from <linux/videodev2.h>.
VIDIOC_G_CTRL = 0xC008561B
V4L2_CID_PRIVACY = 0x009A0910

# A suspend shows up as CLOCK_BOOTTIME running ahead of CLOCK_MONOTONIC.
SLEEP_JUMP_SECONDS = 2.0

# A working sensor keeps reporting while it sees someone. One that has said
# nothing for this long, with nobody known to be there, may never have been
# switched on: the kernel sends its power-on command once, and a sensor that
# missed it (seen on the PX13 after a cold boot) stays silent for good. It is
# then switched off and on again, at growing intervals because an empty room
# may look the same.
STALL_SECONDS = float(os.environ.get("PRESENCE_STALL_SECONDS", "20.0"))
STALL_MAX_SECONDS = 600.0
# How long to wait for the kernel to really power the sensor down. Its
# autosuspend delay is three seconds; re-enabling the buffer sooner changes
# nothing in the sensor at all.
POWER_DOWN_SECONDS = 8.0

# Some sensors lose their detection settings and then see nobody, whoever
# sits there: on the PX13 the presence threshold and the range sensitivity
# read 0 after some boots, through reboots and power-offs, until Windows
# wrote them again. For the sensors listed here the service writes them back
# itself. The values are what Windows leaves in the sensor, by HID sensor
# usage: report interval (ms), range sensitivity and presence threshold (mm),
# head roll, pitch and yaw sensitivity (degrees).
KNOWN_SETTINGS = {
    "13D3:52B9": {0x030E: 50, 0x14B2: 200, 0x74B1: 1200, 0x14C0: 10, 0x14C1: 10, 0x14C2: 10},
}
# A sensor has lost its settings when one of these reads zero.
LOST_WHEN_ZERO = (0x14B2, 0x74B1)
HID_SENSOR_PAGE = 0x20
# HIDIOCSFEATURE(0) and HIDIOCGFEATURE(0) from <linux/hidraw.h>; the length goes in bits 16-29.
HIDIOCSFEATURE = 0xC0004806
HIDIOCGFEATURE = 0xC0004807


class Filter:
    """Turns raw sensor reports into a steady present / away / attentive state.

    Pure logic with the clock passed in, so it can be tested without a sensor.
    `present` is None until the sensor has said enough to decide.
    """

    def __init__(self, arrive=ARRIVE_SECONDS, leave=LEAVE_SECONDS, hold=ATTENTION_HOLD_SECONDS):
        self.arrive = arrive
        self.leave = leave
        self.hold = hold
        self.present = None
        self.attentive = False
        self.distance_mm = None
        self.since = None          # wall-clock time they arrived or left
        self._raw_present = None
        self._raw_present_at = None
        self._raw_attentive = False
        self._inattentive_at = None

    def feed(self, present, attentive, distance_mm, now, wall):
        """Take one sensor report. Returns True when the published state changed."""
        present = bool(present)
        if present != self._raw_present:
            self._raw_present = present
            self._raw_present_at = now
        attentive = bool(attentive) and present
        if attentive:
            self._inattentive_at = None
        elif self._raw_attentive or self._inattentive_at is None:
            self._inattentive_at = now
        self._raw_attentive = attentive

        changed = False
        distance = int(distance_mm) if present and distance_mm and distance_mm > 0 else None
        if present and distance is not None and distance != self.distance_mm:
            self.distance_mm = distance
            changed = True
        return self.tick(now, wall) or changed

    def tick(self, now, wall):
        """Apply the hold times. Returns True when the published state changed."""
        changed = False
        if self._raw_present is not None:
            held = now - self._raw_present_at
            # `since` is when it happened, not when the hold time ran out, so
            # "away for 30 seconds" counts from the moment the seat emptied.
            if self._raw_present and self.present is not True and held >= self.arrive:
                self.present = True
                self.since = wall - held
                changed = True
            elif not self._raw_present and self.present is not False and held >= self.leave:
                self.present = False
                self.since = wall - held
                self.distance_mm = None
                changed = True

        attentive = self.attentive
        if self.present is not True:
            attentive = False
        elif self._raw_attentive:
            attentive = True
        elif self._inattentive_at is not None and now - self._inattentive_at >= self.hold:
            attentive = False
        if attentive != self.attentive:
            self.attentive = attentive
            changed = True
        return changed

    def deadline(self, now):
        """Seconds until tick() could next change something, or None."""
        waits = []
        if self._raw_present is not None:
            held = now - self._raw_present_at
            if self._raw_present and self.present is not True:
                waits.append(self.arrive - held)
            elif not self._raw_present and self.present is not False:
                waits.append(self.leave - held)
        if self.attentive and not self._raw_attentive and self._inattentive_at is not None:
            waits.append(self.hold - (now - self._inattentive_at))
        return max(0.0, min(waits)) if waits else None

    def snapshot(self, wall, camera_privacy=None):
        state = {
            "version": 1,
            "sensor": "ok",
            "present": self.present,
            "attentive": self.attentive,
            "distance_mm": self.distance_mm if self.present else None,
            "since": self.since,
            "camera_privacy": camera_privacy,
            "updated": wall,
        }
        if camera_privacy:
            # The sensor looks through the camera, so with the privacy switch
            # on it sees an empty seat whoever is sitting there. Say "unknown".
            state.update(present=None, attentive=False, distance_mm=None, since=None)
        return state


class Stall:
    """Decides when a silent sensor is due to be switched off and on again.

    Pure logic with the clock passed in.
    """

    def __init__(self, now, first=STALL_SECONDS, longest=STALL_MAX_SECONDS):
        self.first = first
        self.longest = longest
        self.wait = first
        self.last = now
        self.cycles = 0    # power cycles since the sensor last said anything

    def heard(self, now):
        """The sensor reported. Returns True when that ends a silence it was cycled for."""
        recovered = self.cycles > 0
        self.last = now
        self.wait = self.first
        self.cycles = 0
        return recovered

    def due(self, now, present):
        # Someone sitting still is seen without a pause; silence then is not
        # a reason to blind the sensor for a few seconds.
        return present is not True and now - self.last >= self.wait

    def waited(self, now):
        """Something else was tried; give the sensor the first wait again."""
        self.last = now
        self.wait = self.first

    def cycled(self, now):
        self.cycles += 1
        self.last = now
        self.wait = min(self.wait * 2, self.longest)


class Channel:
    """One IIO scan element: where it sits in a record and how to decode it."""

    TYPE = re.compile(r"^(le|be):([su])(\d+)/(\d+)(?:X\d+)?>>(\d+)$")

    def __init__(self, name, index, spec):
        match = self.TYPE.match(spec)
        if not match:
            raise ValueError(f"unsupported scan type {spec!r} for {name}")
        endian, sign, bits, storage, shift = match.groups()
        self.name = name
        self.index = index
        self.big = endian == "be"
        self.signed = sign == "s"
        self.bits = int(bits)
        self.size = int(storage) // 8
        self.shift = int(shift)
        self.offset = 0

    def decode(self, record):
        raw = int.from_bytes(record[self.offset:self.offset + self.size], "big" if self.big else "little")
        raw = (raw >> self.shift) & ((1 << self.bits) - 1)
        if self.signed and raw & (1 << (self.bits - 1)):
            raw -= 1 << self.bits
        return raw


def layout(channels):
    """Place channels the way the kernel does: in index order, each aligned to its size."""
    offset = 0
    for channel in sorted(channels, key=lambda c: c.index):
        if offset % channel.size:
            offset += channel.size - offset % channel.size
        channel.offset = offset
        offset += channel.size
    largest = max(c.size for c in channels)
    if offset % largest:
        offset += largest - offset % largest
    return offset


def read_text(path):
    with open(path, encoding="ascii") as handle:
        return handle.read().strip()


def write_text(path, value):
    with open(path, "w", encoding="ascii") as handle:
        handle.write(str(value))


def find_sensor():
    """The first IIO device that looks like a human-presence sensor."""
    for device in sorted(glob.glob(os.path.join(IIO_ROOT, "iio:device*"))):
        try:
            if read_text(os.path.join(device, "name")) != "prox":
                continue
        except OSError:
            continue
        if os.path.exists(os.path.join(device, "scan_elements", "in_proximity0_en")):
            return device
    return None


class Sensor:
    def __init__(self, device):
        self.device = device
        self.node = "/dev/" + os.path.basename(device)
        self.fd = None
        self.channels = {}
        self.record_size = 0

    def _scan(self, name, suffix):
        return os.path.join(self.device, "scan_elements", f"{name}_{suffix}")

    def open(self):
        names = [n for n in ("in_proximity0", "in_proximity1", "in_attention")
                 if os.path.exists(self._scan(n, "en"))]
        write_text(os.path.join(self.device, "buffer0", "enable"), 0)
        channels = []
        for name in names:
            write_text(self._scan(name, "en"), 1)
            channels.append(Channel(name, int(read_text(self._scan(name, "index"))),
                                    read_text(self._scan(name, "type"))))
        self.record_size = layout(channels)
        self.channels = {c.name: c for c in channels}
        write_text(os.path.join(self.device, "buffer0", "length"), 64)
        write_text(os.path.join(self.device, "buffer0", "enable"), 1)
        self.fd = os.open(self.node, os.O_RDONLY | os.O_NONBLOCK)

    def close(self):
        if self.fd is not None:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = None
        try:
            write_text(os.path.join(self.device, "buffer0", "enable"), 0)
            for name in self.channels:
                write_text(self._scan(name, "en"), 0)
        except OSError:
            pass  # the device is gone; there is nothing left to switch off

    def _power_status(self):
        # Runtime power management sits on the HID sensor the IIO device hangs off.
        try:
            return read_text(os.path.join(os.path.realpath(self.device), "..", "power", "runtime_status"))
        except OSError:
            return None

    def power_cycle(self, timeout=POWER_DOWN_SECONDS, pause=0.25):
        """Switch the sensor off, wait until the kernel has powered it down, and open it again.

        Closing and reopening at once does not reach the sensor: the kernel
        keeps it powered for its autosuspend delay and sends the power-on
        command only when it wakes it from a real power-down. Returns True
        when the power-down was seen.
        """
        self.close()
        down = False
        deadline = time.monotonic() + timeout
        while self._power_status() in ("active", "suspending", "resuming"):
            if time.monotonic() >= deadline:
                break
            time.sleep(pause)
        else:
            down = self._power_status() == "suspended"
        self.open()
        return down

    def read(self):
        """Decoded reports waiting in the buffer: (present, attentive, distance_mm)."""
        try:
            data = os.read(self.fd, self.record_size * 64)
        except BlockingIOError:
            return []
        if not data:
            # select() said readable and there was nothing: the device is gone.
            raise OSError(errno.ENODEV, "sensor went away")
        reports = []
        for start in range(0, len(data) - self.record_size + 1, self.record_size):
            record = data[start:start + self.record_size]
            values = {name: channel.decode(record) for name, channel in self.channels.items()}
            # With two proximity channels the first is the presence flag and the
            # second the distance; a sensor with only one reports presence alone.
            present = values.get("in_proximity0", 0) > 0
            distance = values.get("in_proximity1")
            # Without an attention channel, being there is all that can be asked.
            attentive = values["in_attention"] > 0 if "in_attention" in values else present
            reports.append((present, attentive, distance))
        return reports


class PrivacySwitch:
    """The privacy control of the camera the presence sensor is built into.

    The switch blanks the camera in hardware and blinds the sensor with it,
    with no light to show for it. `read()` gives True, False, or None when
    the camera has no such control.
    """

    def __init__(self, sensor_device):
        self.fd = None
        for node in self._camera_nodes(sensor_device):
            try:
                fd = os.open(node, os.O_RDWR | os.O_NONBLOCK)
            except OSError:
                continue
            self.fd = fd
            if self.read() is not None:
                return
            os.close(fd)
            self.fd = None

    @staticmethod
    def _camera_nodes(sensor_device):
        """Video devices on the same USB device as the sensor."""
        path = os.path.realpath(sensor_device)
        while path != "/" and not os.path.exists(os.path.join(path, "idVendor")):
            path = os.path.dirname(path)
        nodes = glob.glob(os.path.join(path, "*", "video4linux", "video*"))
        return ["/dev/" + os.path.basename(node) for node in sorted(nodes)]

    def read(self):
        if self.fd is None:
            return None
        control = bytearray(struct.pack("Ii", V4L2_CID_PRIVACY, 0))
        try:
            fcntl.ioctl(self.fd, VIDIOC_G_CTRL, control)
        except OSError:
            return None
        return struct.unpack("Ii", control)[1] != 0

    def close(self):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None


def feature_fields(descriptor):
    """Where a HID report descriptor puts its sensor feature values.

    Returns ({usage: (report_id, bit_offset, bits)}, {report_id: byte_length})
    for the plain (variable) fields on the HID sensor page; the first field
    wins when a usage appears twice.
    """
    fields, bits_used = {}, {}
    page = size = count = report_id = 0
    usages, usage_min = [], None
    at = 0
    while at < len(descriptor):
        prefix = descriptor[at]
        if prefix == 0xFE:  # long item: skip it
            at += 3 + (descriptor[at + 1] if at + 1 < len(descriptor) else 0)
            continue
        length = (0, 1, 2, 4)[prefix & 3]
        kind, tag = (prefix >> 2) & 3, prefix >> 4
        value = int.from_bytes(descriptor[at + 1:at + 1 + length], "little")
        at += 1 + length
        if kind == 1:  # global
            if tag == 0:
                page = value
            elif tag == 7:
                size = value
            elif tag == 8:
                report_id = value
            elif tag == 9:
                count = value
        elif kind == 2:  # local
            if tag == 0:
                usages.append(value)
            elif tag == 1:
                usage_min = value
            elif tag == 2 and usage_min is not None:
                usages.extend(range(usage_min, value + 1))
                usage_min = None
        elif kind == 0:  # main
            if tag == 11:  # feature
                offset = bits_used.get(report_id, 0)
                variable = not value & 1 and value & 2
                for index in range(count):
                    if variable and usages and page == HID_SENSOR_PAGE:
                        usage = usages[min(index, len(usages) - 1)]
                        fields.setdefault(usage, (report_id, offset, size))
                    offset += size
                bits_used[report_id] = offset
            usages, usage_min = [], None
    return fields, {rid: (bits + 7) // 8 for rid, bits in bits_used.items()}


def lost_settings(report, places, good):
    """The feature report with `good` written in, when the sensor has lost its settings.

    `report` is the report without its id byte, `places` maps usage to
    (bit_offset, bits). Returns None when nothing reads zero that should not,
    so settings somebody chose on purpose are left alone.
    """
    value = int.from_bytes(report, "little")

    def field(usage):
        offset, bits = places[usage]
        return (value >> offset) & ((1 << bits) - 1)

    if not any(usage in places and usage in good and field(usage) == 0 for usage in LOST_WHEN_ZERO):
        return None
    for usage, wanted in good.items():
        if usage not in places:
            continue
        offset, bits = places[usage]
        mask = (1 << bits) - 1
        value = (value & ~(mask << offset)) | ((wanted & mask) << offset)
    return value.to_bytes(len(report), "little")


class Settings:
    """Writes a known sensor's detection settings back when it has lost them."""

    def __init__(self, sensor_device):
        self.node = None
        self.failed = False
        try:
            # The IIO device hangs off the HID device, which has the raw node.
            path = os.path.realpath(sensor_device)
            while path != "/" and not os.path.isdir(os.path.join(path, "hidraw")):
                path = os.path.dirname(path)
            match = re.match(r"^[0-9A-F]{4}:([0-9A-F]{4}:[0-9A-F]{4})\.", os.path.basename(path))
            good = KNOWN_SETTINGS.get(match.group(1)) if match else None
            if not good:
                return
            with open(os.path.join(path, "report_descriptor"), "rb") as handle:
                fields, lengths = feature_fields(handle.read())
            # Only what sits in the report that holds the presence threshold.
            report_ids = {fields[usage][0] for usage in LOST_WHEN_ZERO if usage in fields}
            if len(report_ids) != 1:
                return
            self.report_id = report_ids.pop()
            self.length = lengths[self.report_id]
            self.places = {usage: (offset, bits) for usage, (rid, offset, bits) in fields.items()
                           if rid == self.report_id}
            self.good = good
            self.node = "/dev/" + sorted(os.listdir(os.path.join(path, "hidraw")))[0]
        except (OSError, IndexError, KeyError):
            self.node = None

    def _feature(self, fd, request, report):
        buffer = bytearray(bytes([self.report_id]) + report)
        fcntl.ioctl(fd, request | (len(buffer) << 16), buffer, True)
        return bytes(buffer[1:])

    def repair(self):
        """Returns True when lost settings were written back."""
        if self.node is None:
            return False
        try:
            fd = os.open(self.node, os.O_RDWR)
            try:
                wanted = lost_settings(self._feature(fd, HIDIOCGFEATURE, bytes(self.length)),
                                       self.places, self.good)
                if wanted is None:
                    return False
                self._feature(fd, HIDIOCSFEATURE, wanted)
                kept = self._feature(fd, HIDIOCGFEATURE, bytes(self.length)) == wanted
            finally:
                os.close(fd)
        except OSError as error:
            if not self.failed:
                log(f"could not check the sensor's settings: {error}")
            self.failed = True
            return False
        if kept:
            log("the sensor had lost its detection settings; wrote them back")
        elif not self.failed:
            log("the sensor has lost its detection settings and did not take them back")
        self.failed = not kept
        return kept


def unavailable(sensor):
    """The state to publish while there is no reading to trust."""
    return {"version": 1, "sensor": sensor, "present": None, "attentive": False,
            "distance_mm": None, "since": None, "camera_privacy": None, "updated": time.time()}


def publish(state):
    """Rewrite the state file in place, so a watcher keeps its handle on it."""
    payload = (json.dumps(state, separators=(",", ":")) + "\n").encode()
    fd = os.open(STATE_FILE, os.O_WRONLY | os.O_CREAT, 0o644)
    try:
        os.pwrite(fd, payload, 0)
        os.ftruncate(fd, len(payload))
    finally:
        os.close(fd)


def sleep_offset():
    return time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()


def log(message):
    print(message, file=sys.stderr, flush=True)


class Stop(Exception):
    pass


def stop(_signum, _frame):
    raise Stop


def watch(sensor, switch, settings):
    """Follow one sensor until it fails or the machine sleeps."""
    state = Filter()
    privacy = switch.read()
    privacy_due = time.monotonic() + PRIVACY_POLL_SECONDS
    publish(state.snapshot(time.time(), privacy))
    offset = sleep_offset()
    stall = Stall(time.monotonic())
    while True:
        now = time.monotonic()
        wait = state.deadline(now)
        ready, _, failed = select.select([sensor.fd], [], [sensor.fd], 1.0 if wait is None else min(wait, 1.0))
        now, wall = time.monotonic(), time.time()

        if abs(sleep_offset() - offset) > SLEEP_JUMP_SECONDS:
            # Whoever was here before the sleep says nothing about now, and the
            # sensor may have been powered down under us: start over.
            log("resumed from sleep, restarting the sensor")
            return
        if failed:
            raise OSError(errno.EIO, "sensor reported an error")

        changed = False
        if ready:
            for present, attentive, distance in sensor.read():
                changed = state.feed(present, attentive, distance, now, wall) or changed
                if stall.heard(now):
                    log("the sensor is reporting again")
        changed = state.tick(now, wall) or changed

        if stall.due(now, state.present) and settings.repair():
            # It reports again by itself once it has its settings.
            stall.waited(time.monotonic())
        elif stall.due(now, state.present):
            if stall.cycles == 0:
                log(f"no report from the sensor for {now - stall.last:.0f} s, switching it off and on")
            # What is published stays: an empty seat is still the best guess.
            down = sensor.power_cycle()
            if not down and stall.cycles == 0:
                log("the kernel did not power the sensor down")
            stall.cycled(time.monotonic())

        if now >= privacy_due:
            privacy_due = now + PRIVACY_POLL_SECONDS
            before, privacy = privacy, switch.read()
            if privacy != before:
                if before and not privacy:
                    # What the blinded sensor said is worthless: decide afresh.
                    state = Filter()
                changed = True
        if changed:
            publish(state.snapshot(wall, privacy))


def main():
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
    sensor = None
    missing_logged = False
    try:
        while True:
            device = find_sensor()
            if device is None:
                if not missing_logged:
                    log("no human-presence sensor found, waiting for one")
                    missing_logged = True
                publish(unavailable("missing"))
                time.sleep(10)
                continue
            missing_logged = False
            sensor = Sensor(device)
            switch = PrivacySwitch(device)
            settings = Settings(device)
            try:
                settings.repair()
                sensor.open()
                log(f"watching {device}")
                watch(sensor, switch, settings)
            except OSError as error:
                log(f"sensor error: {error}")
                # The last reading must not outlive the sensor: "someone is
                # here" left standing would stop the session ever locking.
                publish(unavailable("error"))
                time.sleep(2)
            finally:
                switch.close()
                sensor.close()
                sensor = None
    except Stop:
        pass
    finally:
        if sensor is not None:
            sensor.close()
        try:
            os.unlink(STATE_FILE)
        except OSError:
            pass


