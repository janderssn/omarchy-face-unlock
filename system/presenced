#!/usr/bin/python3 -I
"""Presence daemon for omarchy-face-unlock.

Reads a HID human-presence sensor through the kernel's IIO buffer, filters
out its short dropouts, and publishes who is in front of the laptop to
/run/omarchy-face-unlock/presence.json for the shell plugin and the lock
screen's PAM gate.

The sensor only reports real values while its buffer is enabled, and enabling
it needs root; that is the only reason this runs as a system service. It
opens no sockets and reads nothing but the sensor.
"""

import errno
import glob
import json
import os
import re
import select
import signal
import struct
import sys
import time

STATE_DIR = os.environ.get("PRESENCE_STATE_DIR", "/run/omarchy-face-unlock")
STATE_FILE = os.path.join(STATE_DIR, "presence.json")
IIO_ROOT = os.environ.get("PRESENCE_IIO_ROOT", "/sys/bus/iio/devices")

# Presence must hold this long before someone counts as arrived; the sensor
# occasionally reports a person for a moment when there is none.
ARRIVE_SECONDS = float(os.environ.get("PRESENCE_ARRIVE_SECONDS", "1.0"))
# Absence must hold this long before someone counts as gone. The sensor drops
# to "nobody" whenever the camera is opened: about three seconds for a face
# scan, up to seven when a video call starts. Anything shorter is noise.
LEAVE_SECONDS = float(os.environ.get("PRESENCE_LEAVE_SECONDS", "8.0"))
# Attention is held across the same dropouts.
ATTENTION_HOLD_SECONDS = float(os.environ.get("PRESENCE_ATTENTION_HOLD_SECONDS", "5.0"))

# A suspend shows up as CLOCK_BOOTTIME running ahead of CLOCK_MONOTONIC.
SLEEP_JUMP_SECONDS = 2.0


class Filter:
    """Turns raw sensor reports into a steady present / away / attentive state.

    Pure logic with the clock passed in, so it can be tested without a sensor.
    `present` is None until the sensor has said enough to decide.
    """

    def __init__(self, arrive=ARRIVE_SECONDS, leave=LEAVE_SECONDS, hold=ATTENTION_HOLD_SECONDS):
        self.arrive = arrive
        self.leave = leave
        self.hold = hold
        self.present = None
        self.attentive = False
        self.distance_mm = None
        self.since = None          # wall-clock time they arrived or left
        self._raw_present = None
        self._raw_present_at = None
        self._raw_attentive = False
        self._inattentive_at = None

    def feed(self, present, attentive, distance_mm, now, wall):
        """Take one sensor report. Returns True when the published state changed."""
        present = bool(present)
        if present != self._raw_present:
            self._raw_present = present
            self._raw_present_at = now
        attentive = bool(attentive) and present
        if attentive:
            self._inattentive_at = None
        elif self._raw_attentive or self._inattentive_at is None:
            self._inattentive_at = now
        self._raw_attentive = attentive

        changed = False
        distance = int(distance_mm) if present and distance_mm and distance_mm > 0 else None
        if present and distance is not None and distance != self.distance_mm:
            self.distance_mm = distance
            changed = True
        return self.tick(now, wall) or changed

    def tick(self, now, wall):
        """Apply the hold times. Returns True when the published state changed."""
        changed = False
        if self._raw_present is not None:
            held = now - self._raw_present_at
            # `since` is when it happened, not when the hold time ran out, so
            # "away for 30 seconds" counts from the moment the seat emptied.
            if self._raw_present and self.present is not True and held >= self.arrive:
                self.present = True
                self.since = wall - held
                changed = True
            elif not self._raw_present and self.present is not False and held >= self.leave:
                self.present = False
                self.since = wall - held
                self.distance_mm = None
                changed = True

        attentive = self.attentive
        if self.present is not True:
            attentive = False
        elif self._raw_attentive:
            attentive = True
        elif self._inattentive_at is not None and now - self._inattentive_at >= self.hold:
            attentive = False
        if attentive != self.attentive:
            self.attentive = attentive
            changed = True
        return changed

    def deadline(self, now):
        """Seconds until tick() could next change something, or None."""
        waits = []
        if self._raw_present is not None:
            held = now - self._raw_present_at
            if self._raw_present and self.present is not True:
                waits.append(self.arrive - held)
            elif not self._raw_present and self.present is not False:
                waits.append(self.leave - held)
        if self.attentive and not self._raw_attentive and self._inattentive_at is not None:
            waits.append(self.hold - (now - self._inattentive_at))
        return max(0.0, min(waits)) if waits else None

    def snapshot(self, wall):
        return {
            "version": 1,
            "sensor": "ok",
            "present": self.present,
            "attentive": self.attentive,
            "distance_mm": self.distance_mm if self.present else None,
            "since": self.since,
            "updated": wall,
        }


class Channel:
    """One IIO scan element: where it sits in a record and how to decode it."""

    TYPE = re.compile(r"^(le|be):([su])(\d+)/(\d+)(?:X\d+)?>>(\d+)$")

    def __init__(self, name, index, spec):
        match = self.TYPE.match(spec)
        if not match:
            raise ValueError(f"unsupported scan type {spec!r} for {name}")
        endian, sign, bits, storage, shift = match.groups()
        self.name = name
        self.index = index
        self.big = endian == "be"
        self.signed = sign == "s"
        self.bits = int(bits)
        self.size = int(storage) // 8
        self.shift = int(shift)
        self.offset = 0

    def decode(self, record):
        raw = int.from_bytes(record[self.offset:self.offset + self.size], "big" if self.big else "little")
        raw = (raw >> self.shift) & ((1 << self.bits) - 1)
        if self.signed and raw & (1 << (self.bits - 1)):
            raw -= 1 << self.bits
        return raw


def layout(channels):
    """Place channels the way the kernel does: in index order, each aligned to its size."""
    offset = 0
    for channel in sorted(channels, key=lambda c: c.index):
        if offset % channel.size:
            offset += channel.size - offset % channel.size
        channel.offset = offset
        offset += channel.size
    largest = max(c.size for c in channels)
    if offset % largest:
        offset += largest - offset % largest
    return offset


def read_text(path):
    with open(path, encoding="ascii") as handle:
        return handle.read().strip()


def write_text(path, value):
    with open(path, "w", encoding="ascii") as handle:
        handle.write(str(value))


def find_sensor():
    """The first IIO device that looks like a human-presence sensor."""
    for device in sorted(glob.glob(os.path.join(IIO_ROOT, "iio:device*"))):
        try:
            if read_text(os.path.join(device, "name")) != "prox":
                continue
        except OSError:
            continue
        if os.path.exists(os.path.join(device, "scan_elements", "in_proximity0_en")):
            return device
    return None


class Sensor:
    def __init__(self, device):
        self.device = device
        self.node = "/dev/" + os.path.basename(device)
        self.fd = None
        self.channels = {}
        self.record_size = 0

    def _scan(self, name, suffix):
        return os.path.join(self.device, "scan_elements", f"{name}_{suffix}")

    def open(self):
        names = [n for n in ("in_proximity0", "in_proximity1", "in_attention")
                 if os.path.exists(self._scan(n, "en"))]
        write_text(os.path.join(self.device, "buffer0", "enable"), 0)
        channels = []
        for name in names:
            write_text(self._scan(name, "en"), 1)
            channels.append(Channel(name, int(read_text(self._scan(name, "index"))),
                                    read_text(self._scan(name, "type"))))
        self.record_size = layout(channels)
        self.channels = {c.name: c for c in channels}
        write_text(os.path.join(self.device, "buffer0", "length"), 64)
        write_text(os.path.join(self.device, "buffer0", "enable"), 1)
        self.fd = os.open(self.node, os.O_RDONLY | os.O_NONBLOCK)

    def close(self):
        if self.fd is not None:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = None
        try:
            write_text(os.path.join(self.device, "buffer0", "enable"), 0)
            for name in self.channels:
                write_text(self._scan(name, "en"), 0)
        except OSError:
            pass  # the device is gone; there is nothing left to switch off

    def read(self):
        """Decoded reports waiting in the buffer: (present, attentive, distance_mm)."""
        try:
            data = os.read(self.fd, self.record_size * 64)
        except BlockingIOError:
            return []
        reports = []
        for start in range(0, len(data) - self.record_size + 1, self.record_size):
            record = data[start:start + self.record_size]
            values = {name: channel.decode(record) for name, channel in self.channels.items()}
            # With two proximity channels the first is the presence flag and the
            # second the distance; a sensor with only one reports presence alone.
            present = values.get("in_proximity0", 0) > 0
            distance = values.get("in_proximity1")
            # Without an attention channel, being there is all that can be asked.
            attentive = values["in_attention"] > 0 if "in_attention" in values else present
            reports.append((present, attentive, distance))
        return reports


def publish(state):
    """Rewrite the state file in place, so a watcher keeps its handle on it."""
    payload = (json.dumps(state, separators=(",", ":")) + "\n").encode()
    fd = os.open(STATE_FILE, os.O_WRONLY | os.O_CREAT, 0o644)
    try:
        os.pwrite(fd, payload, 0)
        os.ftruncate(fd, len(payload))
    finally:
        os.close(fd)


def sleep_offset():
    return time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()


def log(message):
    print(message, file=sys.stderr, flush=True)


class Stop(Exception):
    pass


def stop(_signum, _frame):
    raise Stop


def watch(sensor):
    """Follow one sensor until it fails or the machine sleeps."""
    state = Filter()
    publish(state.snapshot(time.time()))
    offset = sleep_offset()
    while True:
        now = time.monotonic()
        wait = state.deadline(now)
        ready, _, failed = select.select([sensor.fd], [], [sensor.fd], 1.0 if wait is None else min(wait, 1.0))
        now, wall = time.monotonic(), time.time()

        if abs(sleep_offset() - offset) > SLEEP_JUMP_SECONDS:
            # Whoever was here before the sleep says nothing about now, and the
            # sensor may have been powered down under us: start over.
            log("resumed from sleep, restarting the sensor")
            return
        if failed:
            raise OSError(errno.EIO, "sensor reported an error")

        changed = False
        if ready:
            for present, attentive, distance in sensor.read():
                changed = state.feed(present, attentive, distance, now, wall) or changed
        changed = state.tick(now, wall) or changed
        if changed:
            publish(state.snapshot(wall))


def main():
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
    sensor = None
    missing_logged = False
    try:
        while True:
            device = find_sensor()
            if device is None:
                if not missing_logged:
                    log("no human-presence sensor found, waiting for one")
                    missing_logged = True
                publish({"version": 1, "sensor": "missing", "present": None, "attentive": False,
                         "distance_mm": None, "since": None, "updated": time.time()})
                time.sleep(10)
                continue
            missing_logged = False
            sensor = Sensor(device)
            try:
                sensor.open()
                log(f"watching {device}")
                watch(sensor)
            except OSError as error:
                log(f"sensor error: {error}")
                time.sleep(2)
            finally:
                sensor.close()
                sensor = None
    except Stop:
        pass
    finally:
        if sensor is not None:
            sensor.close()
        try:
            os.unlink(STATE_FILE)
        except OSError:
            pass


if __name__ == "__main__":
    main()
